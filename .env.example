# .env.example - TEMPLATE (commit to git)
# Copy to .env and fill in your actual values
# NEVER commit .env file to git!

# Supabase Configuration
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_DB_PASSWORD=your-db-password-here

# Application Configuration
NODE_ENV=production
LOG_LEVEL=info

# Encryption & Security
PHONE_ENCRYPTION_KEY=change-me-to-32-character-key!!
PHONE_HASH_SALT=change-me-to-unique-salt-value!!

# API Keys (Third-party services)
VOICE_AI_API_KEY=your-voice-ai-key-here
VOICE_ASSISTANT_ID=your-assistant-id-here
AI_CALLER_ID=your-caller-id-here

# Exotel Configuration
EXOTEL_SID=your-exotel-sid-here
EXOTEL_API_KEY=your-exotel-api-key-here
EXOTEL_API_TOKEN=your-exotel-token-here
EXOTEL_SUBDOMAIN=api.in.exotel.com
EXOTEL_CALLER_ID=your-caller-id-here

# OAuth/External Auth
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-client-id-here
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-secret-here

