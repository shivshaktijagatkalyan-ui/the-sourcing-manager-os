# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Security Configuration
# AES-256 Symmetric Key for pgcrypto
PHONE_ENCRYPTION_KEY=your-long-secure-random-string

# Exotel Configuration (PSTN Bridge)
EXOTEL_SID=your-exotel-sid
EXOTEL_API_KEY=your-exotel-api-key
EXOTEL_API_TOKEN=your-exotel-api-token
EXOTEL_SUBDOMAIN=api.in.exotel.com
EXOTEL_CALLER_ID=your-verified-exotel-number
